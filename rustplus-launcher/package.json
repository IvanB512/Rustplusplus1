{
  "name": "rustpp-launcher",
  "version": "1.0.0",
  "description": "Launcher for Rust++ with activation system",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^22.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "crypto": "^1.0.1"
  },
  "build": {
    "appId": "com.rustpp.launcher",
    "productName": "Rust++ Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist"
    ]
  }
}
